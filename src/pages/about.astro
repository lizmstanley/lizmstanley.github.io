---
import BaseHead from '../components/BaseHead.astro';
import Footer from '../components/Footer.astro';
import Header from '../components/Header.astro';
import PageHero from '../components/PageHero.astro';
import { Image } from 'astro:assets';
import { GITHUB_URL, SITE_TITLE } from '../consts';
import portrait from '../assets/liz-and-cat.jpg';

const facts = [
	{ value: '15+', label: 'years as a software engineer' },
	{ value: '2020', label: 'first year as compiler of the Bloomington, MN CBC' },
	{ value: '1966', label: 'first year of the Bloomington count' },
	{ value: '24', label: 'count areas in the circle' },
	{ value: '2008', label: 'first year of my native plant wildlife garden' },
] as const;
---

<!doctype html>
<html lang="en">
	<head>
		<BaseHead title={`About | ${SITE_TITLE}`} description="About Liz Stanley" />
	</head>
	<body>
		<Header />
		<PageHero eyebrow="About" title="Hi, I'm Liz." subtitle="Software engineer, birder, Master Naturalist, photographer, and Christmas Bird Count compiler." />
		<main>
			<div class="layout">
				<div class="text">
					<p>
						I've been a software engineer for over 15 years. I use AI as an accelerator for my
						experience, under my control, to write production quality applications.
					</p>
					<p>
						I've been the compiler for the{' '}
						<a href="https://www.bloomingtoncbc.org/">Bloomington, MN Christmas Bird Count</a> since
						2020, and a lot of what I build outside of work is for it.
					</p>
					<p>
						I'm a Minnesota Master Naturalist. I volunteer with
						<a href="https://raptor.umn.edu/">The Raptor Center</a>, and I've volunteered at
						Richardson Nature Center and on citizen science projects.
					</p>
					<p>
						In 2008 I started turning my half-acre suburban lot in Bloomington into native plant
						habitat to bring in more birds. Over 90 species of birds have visited it since. I've given
						many talks on gardening for wildlife, for groups like Wild Ones.
						<a
							href="https://neighborhoodgreening.org/plant-it-and-they-will-come-how-one-couple-created-sanctuary-for-wildlife-in-their-half-acre-suburban-yard/"
							>Neighborhood Greening</a
						> wrote about the yard, and I was one of Bloomington's Neighborhood Heroes.
					</p>
					<p>
						I've had a camera on my bird feeders since 2008. Today it's the
						<a href="https://feedercam.overlookcircle.org">Overlook Circle Feedercam</a>, a live stream
						that KSTP's Minnesota Live often shows.
						<a href="https://kstp.com/special-coverage/minnesota-live/the-woman-behind-the-bloomington-bird-feeder-livestream/"
							>KSTP interviewed me</a
						> about it.
					</p>
					<p>
						I'm a weather nerd. I've run a Davis Vantage Pro2 weather station at home since 2007.
						My <a href="https://github.com/lizmstanley/webcam-weather">webcam-weather</a> project puts
						its live readings on the feedercam stream.
					</p>
					<p>
						I'm an avid photographer. My bird photos are of wild birds, and you can see them on
						<a href="https://pbase.com/gymell">PBase</a> and
						<a href="https://www.instagram.com/lizmstanley/">Instagram</a>. My sightings are on
						<a href="https://ebird.org/profile/MTk5Mzk1">eBird</a>.
					</p>
					<p>My code is on <a href={GITHUB_URL}>GitHub</a>, and my <a href="/resume">resume</a> is here.</p>
				</div>
				<aside>
					<Image src={portrait} alt="Liz Stanley with her black and white cat" width={640} height={640} class="portrait" />
					<p class="eyebrow">At a glance</p>
					<dl>
						{
							facts.map((fact) => (
								<div>
									<dt>{fact.value}</dt>
									<dd>{fact.label}</dd>
								</div>
							))
						}
					</dl>
				</aside>
			</div>
		</main>
		<Footer />
	</body>
</html>

<style>
	.layout {
		display: grid;
		grid-template-columns: minmax(0, 1fr) 20rem;
		align-items: start;
		gap: 4rem;
	}
	.text {
		font-size: 1.1rem;
	}
	.text p:first-child {
		font-size: 1.25rem;
	}
	aside {
		padding: 1.75rem;
		background: var(--paper-raised);
		border: 1px solid var(--rule);
		border-radius: var(--radius);
	}
	.portrait {
		width: 100%;
		height: auto;
		margin-bottom: 1.5rem;
		border-radius: 50%;
	}
	dl {
		display: grid;
		gap: 1.25rem;
		margin: 0;
	}
	dt {
		font-family: var(--font-fraunces);
		font-size: 2.2rem;
		font-weight: 600;
		line-height: 1;
		color: var(--spruce);
	}
	dd {
		margin: 0.3rem 0 0;
		font-size: 0.9rem;
		color: var(--ink-soft);
	}
	@media (max-width: 820px) {
		.layout {
			grid-template-columns: 1fr;
			gap: 2rem;
		}
	}
</style>
