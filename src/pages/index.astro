---
import BaseHead from '../components/BaseHead.astro';
import CountCircle from '../components/CountCircle.astro';
import Footer from '../components/Footer.astro';
import Header from '../components/Header.astro';
import PostList from '../components/PostList.astro';
import ProjectCard from '../components/ProjectCard.astro';
import { SITE_DESCRIPTION, SITE_TITLE } from '../consts';
import { getPosts } from '../posts';

const LATEST_POST_COUNT = 5;
const latestPosts = (await getPosts()).slice(0, LATEST_POST_COUNT);
---

<!doctype html>
<html lang="en">
	<head>
		<BaseHead title={SITE_TITLE} description={SITE_DESCRIPTION} />
	</head>
	<body>
		<Header />
		<main>
			<section class="hero">
				<div class="intro">
					<p class="eyebrow">Software engineer &middot; CBC compiler</p>
					<h1>I build software, and I <em>watch birds</em>.</h1>
					<p class="lede">
						I've been a software engineer for over 15 years. Outside of work I'm the compiler for
						the <a href="https://www.bloomingtoncbc.org/">Bloomington, MN Christmas Bird Count</a>,
						and I build the tools that help run it.
					</p>
					<p class="actions">
						<a class="button" href="/blog">Read the blog</a>
						<a class="button quiet" href="#projects">See projects</a>
					</p>
				</div>
				<div class="art">
					<CountCircle />
				</div>
			</section>

			<div class="section-title" id="projects">
				<h2>Projects</h2>
			</div>
			<div class="grid">
				<ProjectCard
					kind="Phone app"
					title="Birdspotter"
					href="/birdspotter/app/"
					stack={['PWA', 'MapLibre', 'eBird API']}
				>
					For any birder: a map of where you are, with recent sightings and eBird hotspots around
					you. Installs to your phone's home screen.
				</ProjectCard>
				<ProjectCard
					kind="Web app"
					title="CBC Circle Manager"
					href="/birdspotter/cbc/manager/"
					stack={['TypeScript', 'React', 'PGlite', 'MapLibre']}
				>
					A browser-only app for Christmas Bird Count compilers: roster, area assignments, and
					results, with Postgres running inside the browser.
				</ProjectCard>
				<ProjectCard
					kind="Phone app"
					title="CBC Scout"
					href="/birdspotter/cbc/scout/"
					stack={['PWA', 'MapLibre', 'eBird API', 'QR codes']}
				>
					For field counters: loads their area from a QR code, shows where they are in it and what's
					been seen nearby, and records the party's hours and miles.
				</ProjectCard>
				<ProjectCard
					kind="Scripts"
					title="cbc_utils"
					href="https://github.com/lizmstanley/cbc_utils"
					stack={['Python', 'TypeScript', 'Puppeteer']}
				>
					eBird sightings to map layers, results data entry into Audubon and MOU, and count sheet
					transcription.
				</ProjectCard>
			</div>

			{
				latestPosts.length > 0 && (
					<>
						<div class="section-title">
							<h2>Latest posts</h2>
							<a href="/blog">All posts &rarr;</a>
						</div>
						<PostList posts={latestPosts} />
					</>
				)
			}
		</main>
		<Footer />
	</body>
</html>

<style>
	.hero {
		display: grid;
		grid-template-columns: 1.25fr 1fr;
		align-items: center;
		gap: 3rem;
		padding: 2rem 0 1rem;
	}
	h1 {
		font-size: clamp(2.6rem, 6vw, 4.2rem);
		font-weight: 700;
	}
	h1 em {
		font-weight: 400;
		color: var(--cardinal);
	}
	.lede {
		max-width: 34rem;
		font-size: 1.15rem;
		color: var(--ink-soft);
	}
	.actions {
		display: flex;
		flex-wrap: wrap;
		gap: 0.75rem;
		margin-top: 2rem;
	}
	.button {
		padding: 0.6rem 1.2rem;
		font-weight: 700;
		font-size: 0.95rem;
		color: var(--paper);
		text-decoration: none;
		background: var(--spruce);
		border: 1px solid var(--spruce);
		border-radius: 999px;
	}
	.button:hover {
		color: var(--paper);
		background: var(--cardinal);
		border-color: var(--cardinal);
	}
	.button.quiet {
		color: var(--spruce);
		background: transparent;
	}
	.button.quiet:hover {
		color: var(--cardinal);
		background: transparent;
	}
	.art {
		max-width: 400px;
		justify-self: center;
		width: 100%;
	}
	.grid {
		display: grid;
		grid-template-columns: repeat(auto-fit, minmax(17rem, 1fr));
		gap: 1.25rem;
	}
	@media (max-width: 820px) {
		.hero {
			grid-template-columns: 1fr;
			gap: 2rem;
		}
		.art {
			max-width: 280px;
			order: -1;
		}
	}
</style>
