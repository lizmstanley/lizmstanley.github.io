---
import { Image } from 'astro:assets';
import type { CollectionEntry } from 'astro:content';
import BaseHead from '../components/BaseHead.astro';
import Footer from '../components/Footer.astro';
import FormattedDate from '../components/FormattedDate.astro';
import Header from '../components/Header.astro';
import PageHero from '../components/PageHero.astro';

type Props = CollectionEntry<'blog'>['data'] & { readingMinutes: number };

const { title, description, pubDate, updatedDate, heroImage, readingMinutes } = Astro.props;
---

<!doctype html>
<html lang="en">
	<head>
		<BaseHead title={title} description={description} image={heroImage} />
	</head>
	<body>
		<Header />
		<PageHero eyebrow="Blog" title={title} subtitle={description}>
			<Fragment slot="eyebrow">
				<a href="/blog">Blog</a> &middot; <FormattedDate date={pubDate} /> &middot; {readingMinutes} min
				read
				{
					updatedDate && (
						<>
							&middot; Updated <FormattedDate date={updatedDate} />
						</>
					)
				}
			</Fragment>
		</PageHero>
		<main>
			<article>
				{heroImage && <Image class="hero" width={1020} height={510} src={heroImage} alt="" />}
				<div class="prose">
					<slot />
				</div>
				<p class="back"><a href="/blog">&larr; All posts</a></p>
			</article>
		</main>
		<Footer />
	</body>
</html>

<style>
	:global(.page-hero .eyebrow a) {
		color: inherit;
		text-decoration: none;
	}
	article {
		max-width: var(--measure);
		margin: 0 auto;
	}
	.hero {
		margin-bottom: 2.5rem;
		border-radius: var(--radius);
	}
	.prose {
		font-size: 1.05em;
	}
	.prose > :global(p:first-child) {
		font-size: 1.15em;
		color: var(--ink);
	}
	.prose :global(h2) {
		position: relative;
		margin-top: 2.4em;
		padding-top: 1.2em;
		font-size: 1.75rem;
	}
	.prose :global(h2)::before {
		content: '';
		position: absolute;
		top: 0;
		left: 0;
		width: 3rem;
		height: 3px;
		background: var(--cardinal);
		border-radius: 2px;
	}
	.prose :global(h3) {
		margin-top: 1.8em;
	}
	.prose :global(ul),
	.prose :global(ol) {
		padding-left: 1.3em;
	}
	.prose :global(li) {
		margin-bottom: 0.4em;
	}
	.prose :global(li::marker) {
		color: var(--spruce);
	}
	.back {
		margin-top: 3.5rem;
		padding-top: 1.5rem;
		border-top: 1px solid var(--rule);
		font-weight: 700;
	}
</style>
