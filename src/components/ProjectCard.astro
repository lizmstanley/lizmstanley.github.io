---
interface Props {
	kind: string;
	title: string;
	href: string;
	stack: readonly string[];
}

const { kind, title, href, stack } = Astro.props;
---

<a class="card" href={href}>
	<p class="eyebrow">{kind}</p>
	<h3>{title}</h3>
	<p class="body"><slot /></p>
	<ul class="stack">
		{stack.map((item) => <li>{item}</li>)}
	</ul>
	<span class="go" aria-hidden="true">&rarr;</span>
</a>

<style>
	.card {
		position: relative;
		display: flex;
		flex-direction: column;
		padding: 1.5rem 1.5rem 1.25rem;
		color: var(--ink);
		text-decoration: none;
		background: var(--paper-raised);
		border: 1px solid var(--rule);
		border-radius: var(--radius);
		transition:
			transform 0.15s ease,
			box-shadow 0.15s ease,
			border-color 0.15s ease;
	}
	.card:hover {
		color: var(--ink);
		border-color: var(--spruce);
		box-shadow: var(--shadow);
		transform: translateY(-2px);
	}
	h3 {
		margin-bottom: 0.4em;
	}
	.body {
		flex: 1;
		color: var(--ink-soft);
		font-size: 0.95rem;
	}
	.stack {
		display: flex;
		flex-wrap: wrap;
		gap: 0.4rem;
		margin: 0;
		padding: 0;
		list-style: none;
	}
	.stack li {
		padding: 0.15rem 0.6rem;
		font-size: 0.75rem;
		color: var(--spruce);
		background: var(--spruce-soft);
		border-radius: 999px;
	}
	.go {
		position: absolute;
		top: 1.25rem;
		right: 1.5rem;
		color: var(--ink-faint);
		transition: transform 0.15s ease;
	}
	.card:hover .go {
		color: var(--cardinal);
		transform: translateX(3px);
	}
</style>
