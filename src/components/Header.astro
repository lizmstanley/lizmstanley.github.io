---
import CircleMark from './CircleMark.astro';
import GitHubLink from './GitHubLink.astro';
import HeaderLink from './HeaderLink.astro';
import { SITE_TITLE } from '../consts';
---

<header>
	<nav>
		<a class="brand" href="/">
			<CircleMark />
			<span>{SITE_TITLE}</span>
		</a>
		<div class="links">
			<HeaderLink href="/blog">Blog</HeaderLink>
			<HeaderLink href="/about">About</HeaderLink>
			<GitHubLink />
		</div>
	</nav>
</header>

<style>
	header {
		position: sticky;
		top: 0;
		z-index: 10;
		background: color-mix(in srgb, var(--paper) 88%, transparent);
		backdrop-filter: blur(8px);
		border-bottom: 1px solid var(--rule);
	}
	nav {
		display: flex;
		align-items: center;
		justify-content: space-between;
		max-width: var(--page);
		margin: 0 auto;
		padding: 0.75rem 1.5rem;
	}
	.brand {
		display: flex;
		align-items: center;
		gap: 0.6rem;
		font-family: var(--font-fraunces);
		font-size: 1.25rem;
		font-weight: 600;
		color: var(--ink);
		text-decoration: none;
	}
	.brand:hover {
		color: var(--ink);
	}
	.links {
		display: flex;
		align-items: center;
		gap: 1.5rem;
	}
	.links :global(a) {
		display: flex;
		color: var(--ink-soft);
		text-decoration: none;
	}
	.links :global(a:hover),
	.links :global(a.active) {
		color: var(--cardinal);
	}
	.links :global(svg) {
		width: 24px;
		height: 24px;
	}
	@media (max-width: 720px) {
		nav {
			padding: 0.75rem 1rem;
		}
		.links {
			gap: 1rem;
		}
	}
</style>
