---
interface Props {
	eyebrow: string;
	title: string;
	subtitle?: string;
}

const { eyebrow, title, subtitle } = Astro.props;
---

<section class="page-hero">
	<div class="inner">
		<p class="eyebrow"><slot name="eyebrow">{eyebrow}</slot></p>
		<h1>{title}</h1>
		{subtitle && <p class="subtitle">{subtitle}</p>}
	</div>
	<svg class="watermark" viewBox="0 0 32 32" aria-hidden="true">
		<circle cx="16" cy="16" r="13" fill="none" stroke="currentColor" stroke-width="0.25" stroke-dasharray="1 1"></circle>
		<path d="M16 3 L14 16 L4 21 M14 16 L26 23" fill="none" stroke="currentColor" stroke-width="0.25"></path>
		<circle cx="20" cy="11" r="1.6" fill="var(--cardinal)"></circle>
	</svg>
</section>

<style>
	.page-hero {
		position: relative;
		overflow: hidden;
		background: var(--spruce-soft);
		border-bottom: 1px solid var(--rule);
	}
	.inner {
		position: relative;
		z-index: 1;
		max-width: var(--page);
		margin: 0 auto;
		padding: 4rem 1.5rem 3.5rem;
	}
	h1,
	.subtitle {
		max-width: min(40rem, calc(100% - 320px));
	}
	h1 {
		margin-bottom: 0.4em;
	}
	.subtitle {
		margin: 0;
		font-size: 1.2rem;
		color: var(--ink-soft);
	}
	.watermark {
		position: absolute;
		top: 50%;
		right: max(1.5rem, calc((100% - var(--page)) / 2));
		width: 300px;
		height: 300px;
		color: var(--spruce);
		opacity: 0.35;
		transform: translateY(-50%);
	}
	@media (max-width: 820px) {
		.inner {
			padding: 2.5rem 1rem 2.25rem;
		}
		h1,
		.subtitle {
			max-width: none;
		}
		.watermark {
			right: -80px;
			width: 220px;
			height: 220px;
			opacity: 0.2;
		}
	}
</style>
