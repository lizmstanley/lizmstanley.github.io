---
import CircleMark from './CircleMark.astro';
import { GITHUB_URL } from '../consts';

const year = new Date().getFullYear();
---

<footer>
	<div class="inner">
		<span class="mark"><CircleMark size={22} /></span>
		<span>&copy; {year} Liz Stanley</span>
		<span class="links">
			<a href="/rss.xml">RSS</a>
			<a href={GITHUB_URL}>GitHub</a>
		</span>
	</div>
</footer>

<style>
	footer {
		border-top: 1px solid var(--rule);
		color: var(--ink-faint);
		font-size: 0.9rem;
	}
	.inner {
		display: flex;
		align-items: center;
		gap: 0.75rem;
		max-width: var(--page);
		margin: 0 auto;
		padding: 2rem 1.5rem 3rem;
	}
	.mark {
		display: flex;
		color: var(--spruce);
	}
	.links {
		display: flex;
		gap: 1.25rem;
		margin-left: auto;
	}
	.links a {
		color: var(--ink-faint);
	}
	.links a:hover {
		color: var(--cardinal);
	}
</style>
