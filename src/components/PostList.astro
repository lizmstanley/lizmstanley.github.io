---
import type { CollectionEntry } from 'astro:content';
import FormattedDate from './FormattedDate.astro';

interface Props {
	posts: readonly CollectionEntry<'blog'>[];
}

const { posts } = Astro.props;
---

<ul>
	{
		posts.map((post) => (
			<li>
				<a href={`/blog/${post.id}/`}>
					<FormattedDate date={post.data.pubDate} />
					<span class="title">{post.data.title}</span>
					<span class="description">{post.data.description}</span>
				</a>
			</li>
		))
	}
</ul>

<style>
	ul {
		margin: 0;
		padding: 0;
		list-style: none;
	}
	li + li {
		border-top: 1px solid var(--rule);
	}
	a {
		display: grid;
		grid-template-columns: 8rem 1fr;
		gap: 0.25rem 1.5rem;
		padding: 1.25rem 0;
		color: var(--ink);
		text-decoration: none;
	}
	a :global(time) {
		grid-row: span 2;
		padding-top: 0.3rem;
		font-size: 0.85rem;
		color: var(--ink-faint);
	}
	.title {
		font-family: var(--font-fraunces);
		font-size: 1.3rem;
		font-weight: 600;
		line-height: 1.25;
	}
	.description {
		color: var(--ink-soft);
		font-size: 0.95rem;
	}
	a:hover .title {
		color: var(--cardinal);
	}
	@media (max-width: 720px) {
		a {
			grid-template-columns: 1fr;
		}
		a :global(time) {
			grid-row: auto;
			padding: 0;
		}
	}
</style>
