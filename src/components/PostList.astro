---
import type { CollectionEntry } from 'astro:content';
import FormattedDate from './FormattedDate.astro';
import { readingMinutes } from '../posts';

interface Props {
	posts: readonly CollectionEntry<'blog'>[];
}

const { posts } = Astro.props;
---

<ul>
	{
		posts.map((post) => (
			<li>
				<a href={`/blog/${post.id}/`}>
					<p class="meta">
						<FormattedDate date={post.data.pubDate} /> &middot; {readingMinutes(post)} min read
					</p>
					<h3>{post.data.title}</h3>
					<p class="description">{post.data.description}</p>
					<span class="more">
						Read post <span aria-hidden="true">&rarr;</span>
					</span>
				</a>
			</li>
		))
	}
</ul>

<style>
	ul {
		display: grid;
		gap: 1.25rem;
		margin: 0;
		padding: 0;
		list-style: none;
	}
	a {
		position: relative;
		display: block;
		padding: 1.75rem 2rem 1.5rem 2.25rem;
		color: var(--ink);
		text-decoration: none;
		background: var(--paper-raised);
		border: 1px solid var(--rule);
		border-radius: var(--radius);
		transition:
			transform 0.15s ease,
			box-shadow 0.15s ease,
			border-color 0.15s ease;
	}
	a::before {
		content: '';
		position: absolute;
		top: 1.5rem;
		bottom: 1.5rem;
		left: 0;
		width: 4px;
		background: var(--cardinal);
		border-radius: 0 4px 4px 0;
	}
	a:hover {
		color: var(--ink);
		border-color: var(--spruce);
		box-shadow: var(--shadow);
		transform: translateY(-2px);
	}
	.meta {
		margin-bottom: 0.5rem;
		font-size: 0.85rem;
		color: var(--ink-faint);
	}
	h3 {
		margin-bottom: 0.4em;
		font-size: 1.5rem;
	}
	.description {
		margin-bottom: 1rem;
		color: var(--ink-soft);
	}
	.more {
		font-size: 0.9rem;
		font-weight: 700;
		color: var(--spruce);
	}
	a:hover .more {
		color: var(--cardinal);
	}
	@media (max-width: 720px) {
		a {
			padding: 1.25rem 1.25rem 1.25rem 1.5rem;
		}
	}
</style>
